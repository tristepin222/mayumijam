[sub_resource type="Resource" id="Resource_line_1"]
script = ExtResource("2_line")
emotion = "angry"
character = 1
text = "What in tarnation? You lily-livered spirits got no way of getting' so tough!"
slot = 0
effect = ""

[sub_resource type="Resource" id="Resource_line_2"]
script = ExtResource("2_line")
emotion = "annoyed"
character = 1
text = "Who's you hidin' back there? I needta smash that coward! Ya can't hide her forever!"
slot = 0
effect = "shake"

[sub_resource type="Resource" id="Resource_line_3"]
script = ExtResource("2_line")
emotion = "determined"
character = 2
text = "That is well enough. I am done hiding."
slot = 2
effect = ""

[sub_resource type="Resource" id="Resource_line_4"]
script = ExtResource("2_line")
emotion = "surprised"
character = 0
text = "Lady Keiki!"
slot = 1
effect = ""

[sub_resource type="Resource" id="Resource_line_5"]
script = ExtResource("2_line")
emotion = "eager"
character = 1
text = "About damn time! Now I crush ya personally!"
slot = 3
effect = ""

[sub_resource type="Resource" id="Resource_line_6"]
script = ExtResource("2_line")
emotion = "determined"
character = 2
text = "But you have already been fighting me."
slot = 2
effect = ""

[sub_resource type="Resource" id="Resource_line_7"]
script = ExtResource("2_line")
emotion = "annoyed"
character = 1
text = "What are you yapping about?"
slot = 3
effect = ""

[sub_resource type="Resource" id="Resource_line_8"]
script = ExtResource("2_line")
emotion = "determined"
character = 2
text = "She is my right hand. My will forged to clay. To face her is to stand against me."
slot = 2
music_cue = "saki_phase2"
effect = ""

[sub_resource type="Resource" id="Resource_line_9"]
script = ExtResource("2_line")
emotion = "blushing"
character = 0
text = "Keiki! That's… a bit much…"
slot = 1
effect = ""

[sub_resource type="Resource" id="Resource_line_10"]
script = ExtResource("2_line")
emotion = "excited"
character = 2
text = "You stand against Mayumi Joutouguu, made family by more than mere flesh and blood!"
slot = 2
effect = ""

[sub_resource type="Resource" id="Resource_line_11"]
script = ExtResource("2_line")
emotion = "surprised"
character = 0
speaker_name_override = "Mayumi Joutouguu"
text = "And a family name… no wait, how did the dialogue box change already?!"
