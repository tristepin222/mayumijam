effect = ""

[sub_resource type="Resource" id="Resource_line_12"]
script = ExtResource("2_line")
emotion = "determined"
character = 0
speaker_name_override = "Mayumi Joutouguu"
text = "No, nevermind. I have seen Lady Keiki's vision. The change that will sweep over the Animal Realm!"
slot = 1
effect = ""

[sub_resource type="Resource" id="Resource_line_13"]
script = ExtResource("2_line")
emotion = "determined"
character = 2
text = "The humans will know peace…"
slot = 2
effect = ""

[sub_resource type="Resource" id="Resource_line_14"]
script = ExtResource("2_line")
emotion = "determined"
character = 0
speaker_name_override = "Mayumi Joutouguu"
text = "… by my sword!"
slot = 1
effect = ""

[sub_resource type="Resource" id="Resource_line_15"]
script = ExtResource("2_line")
emotion = "excited"
character = 2
speaker_name_override = "Keiki and Mayumi"
text = "Your tyranny is over, Saki Kurokoma!"
