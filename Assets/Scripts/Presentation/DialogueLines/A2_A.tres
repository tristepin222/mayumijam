[sub_resource type="Resource" id="Resource_line_6"]
script = ExtResource("2_line")
emotion = "excited"
character = 2
text = "But don't worry, this ceramic skin will be far more durable than ghost fluff. And thanks to this new molding technique, it won't slow you down at all. In fact, it should-"
