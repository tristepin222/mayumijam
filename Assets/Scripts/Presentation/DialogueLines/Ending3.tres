[gd_resource type="Resource" script_class="DialogStruct" format=3 uid="uid://wryfsxxb3r2m"]

[ext_resource type="Script" uid="uid://s4fjncmjbqsw" path="res://Assets/Scripts/Progression/Structs/DialogStruct.gd" id="1_struct"]
[ext_resource type="Script" uid="uid://dhec4gun2r35p" path="res://Assets/Scripts/Progression/Structs/DialogLine.gd" id="2_line"]

[sub_resource type="Resource" id="Resource_line_1"]
script = ExtResource("2_line")
character = 1
slot = 3
text = "Gah! How- I wasn't holdin' back..."

[sub_resource type="Resource" id="Resource_line_2"]
script = ExtResource("2_line")
character = 1
slot = 3
text = "D-damnit! This ain't over!"

[sub_resource type="Resource" id="Resource_line_3"]
script = ExtResource("2_line")
character = 0
slot = 1
speaker_name_override = "Mayumi and Keiki"
text = "No, it is just beginning!"

[sub_resource type="Resource" id="Resource_line_4"]
script = ExtResource("2_line")
character = 1
slot = 3
text = "An' stop talking together like that! It's creepy."

[sub_resource type="Resource" id="Resource_line_5"]
script = ExtResource("2_line")
character = 0
slot = 1
speaker_name_override = "Mayumi and Keiki"
text = "Your time is past! Make way for the future of the Animal Realm!"

[sub_resource type="Resource" id="Resource_line_6"]
script = ExtResource("2_line")
character = 1
slot = 3
text = "Ugh, f-forget it. Come on gals, let's skedaddle before the choir starts singin'."

[sub_resource type="Resource" id="Resource_line_7"]
script = ExtResource("2_line")
character = 3
slot = 0
speaker_name_override = ""
text = "Saki's defeat sent ripples through the Animal Realm. But what followed amounted to a tsunami. Mayumi Joutouguu, newly anointed as Keiki's chief officer, marched out across the bridge leading an army of haniwa."

[sub_resource type="Resource" id="Resource_line_8"]
script = ExtResource("2_line")
character = 3
slot = 0
speaker_name_override = ""
text = "With all the improvements and adjustments from their encounters with Saki, the less than imposing clay soldiers proved utterly immune to the very essence of the animal spirits they opposed. Keiki and Mayumi threatened to topple the world order, forging a new one of smooth ceramic."

[sub_resource type="Resource" id="Resource_line_9"]
script = ExtResource("2_line")
character = 3
slot = 0
speaker_name_override = ""
text = "The resulting chaos spread leagues beyond the skyscrapers of the animal gangs. Fleeing spirits leaked all the way to a tiny backwater realm known as Gensokyo, leading a trio to investigate..."

[sub_resource type="Resource" id="Resource_line_10"]
script = ExtResource("2_line")
character = 3
slot = 0
speaker_name_override = ""
text = "Ending 3: Haniwa Lance Corporal"

[resource]
script = ExtResource("1_struct")
dialog_lines = Array[ExtResource("2_line")]([SubResource("Resource_line_1"), SubResource("Resource_line_2"), SubResource("Resource_line_3"), SubResource("Resource_line_4"), SubResource("Resource_line_5"), SubResource("Resource_line_6"), SubResource("Resource_line_7"), SubResource("Resource_line_8"), SubResource("Resource_line_9"), SubResource("Resource_line_10")])
