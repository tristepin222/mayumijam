[ext_resource type="Script" uid="uid://s4fjncmjbqsw" path="res://Assets/Scripts/Progression/Structs/DialogStruct.gd" id="1_struct"]
[ext_resource type="Script" uid="uid://dhec4gun2r35p" path="res://Assets/Scripts/Progression/Structs/DialogLine.gd" id="2_line"]

[sub_resource type="Resource" id="Resource_line_1"]
script = ExtResource("2_line")
text = "With nothing but her own raw, unyielding spiritual strength, Mayumi beats down the Matriarch of the Keiga family."

[sub_resource type="Resource" id="Resource_line_2"]
script = ExtResource("2_line")
text = "Without Keiki's guidance or reshaping, old instincts take hold. Mayumi establishes her own faction in the Animal Realm—a ruthless new syndicate with herself as its unchallenged matriarch."

[sub_resource type="Resource" id="Resource_line_3"]
script = ExtResource("2_line")
text = "She falls into endless conflict with the other beast families, finding the backstabbing, territory wars, and violence all too familiar.

Mayumi slips back into old habits, spinning fiendish plots of her own to eradicate all who oppose her."

[resource]
script = ExtResource("1_struct")
dialog_lines = Array[ExtResource("2_line")]([SubResource("Resource_line_1"), SubResource("Resource_line_2"), SubResource("Resource_line_3")])
